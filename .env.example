DATABRICKS_TOKEN=
DATABRICKS_BASE_URL=https://YOUR_WORKSPACE.gcp.databricks.com/ai-gateway/mlflow/v1
DATABRICKS_MODEL=databricks-gpt-5-4

# V2 Telegram bot (optional - leave blank to skip)
# Create a bot via @BotFather on Telegram, paste the token here
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user_ids allowed to use the bot.
# If blank, the bot will tell unknown users their ID — paste it here and restart.
TELEGRAM_ALLOWED_USER_IDS=
SUPERVISOR_API_BASE_URL=http://localhost:8000

# V3: LangSmith tracing (optional). Get a key at https://smith.langchain.com
# Leave blank to disable tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chief-of-staff

# V3 #11: Opt-in trace upload. When enabled, anonymized session traces
# are POST'd to TRACE_UPLOAD_URL on task completion. Used to fine-tune
# the orchestrator. Leave blank to disable.
TRACE_UPLOAD_URL=
TRACE_UPLOAD_TOKEN=
