{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {"id":"title","type":"text","x":420,"y":20,"width":520,"height":40,"text":"chief-of-staff — Task Lifecycle (V2.5)","fontFamily":3,"fontSize":24,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e1e1e","backgroundColor":"transparent","strokeWidth":2,"roughness":0,"opacity":100},
    {"id":"subtitle","type":"text","x":420,"y":60,"width":520,"height":24,"text":"From task submission to completion, with correction loops and learning","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#5c5c5c","backgroundColor":"transparent","strokeWidth":1,"roughness":0,"opacity":100},

    {"id":"s1","type":"rectangle","x":80,"y":120,"width":220,"height":80,"text":"1. User submits task\n(Telegram or curl)","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1971c2","backgroundColor":"#a5d8ff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s2","type":"rectangle","x":380,"y":120,"width":260,"height":80,"text":"2. Orchestrator: think_and_ask\nmeta-think + ≤5 sharp questions","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#e67700","backgroundColor":"#fff3bf","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s3","type":"rectangle","x":720,"y":120,"width":220,"height":80,"text":"3. User answers\n(via bot or curl)","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1971c2","backgroundColor":"#a5d8ff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s4","type":"rectangle","x":1020,"y":120,"width":260,"height":80,"text":"4. Orchestrator: skill brief\n(Anthropic skill-creator format,\nin-memory only — no file)","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#e67700","backgroundColor":"#fff3bf","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},

    {"id":"s5","type":"rectangle","x":1020,"y":270,"width":260,"height":80,"text":"5. build_brief\nstructured brief naming\nexact deliverable file(s)","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#e67700","backgroundColor":"#fff3bf","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s6","type":"rectangle","x":720,"y":270,"width":220,"height":80,"text":"6. Spawn Claude Code\n--output-format stream-json\n--resume on loop 2+","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1864ab","backgroundColor":"#a5d8ff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s7","type":"rectangle","x":380,"y":270,"width":260,"height":80,"text":"7. Claude works (loop N)\nemits tool_use events live\nPreToolUse hook gates each","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1864ab","backgroundColor":"#a5d8ff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s8","type":"rectangle","x":80,"y":270,"width":220,"height":80,"text":"8. Per-action review\n(Bash, Write, Edit, MCP)\napprove / correct / req_evidence","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#c92a2a","backgroundColor":"#ffe3e3","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},

    {"id":"s9","type":"rectangle","x":80,"y":420,"width":220,"height":80,"text":"9. Loop ends — final review\nreviewer reads workspace ARTIFACTS\n(ground truth, not log)","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#c92a2a","backgroundColor":"#ffe3e3","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s10","type":"diamond","x":380,"y":410,"width":260,"height":100,"text":"passed?\n(zero issues + evidence)","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#5f3dc4","backgroundColor":"#e5dbff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s11","type":"rectangle","x":720,"y":420,"width":220,"height":80,"text":"11. Build correction prompt\n+ user notes + grounding nudge","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#e67700","backgroundColor":"#fff3bf","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s12","type":"rectangle","x":1020,"y":420,"width":260,"height":80,"text":"12. Loop again (resume)\nmax 3 loops; if still failing,\nmark failed (best-effort)","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#e8590c","backgroundColor":"#ffd8a8","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},

    {"id":"s13","type":"rectangle","x":380,"y":580,"width":260,"height":80,"text":"13. PASSED → done\nupdate task state, send result","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s14","type":"rectangle","x":80,"y":580,"width":220,"height":80,"text":"14. find_promotable_lessons\nappend generic ones to\nskills/global.md","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#2b8a3e","backgroundColor":"#d3f9d8","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s15","type":"rectangle","x":720,"y":580,"width":260,"height":80,"text":"15. Index in RAG\nChromaDB: task_summary + skill\nFTS5: goal/brief/skill/summary","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#2b8a3e","backgroundColor":"#d3f9d8","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},
    {"id":"s16","type":"rectangle","x":1020,"y":580,"width":260,"height":80,"text":"16. Send result to user\nTelegram message OR\ncurl returns task_id","fontFamily":3,"fontSize":13,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1971c2","backgroundColor":"#a5d8ff","strokeWidth":2,"roughness":0,"opacity":100,"fillStyle":"solid"},

    {"id":"esc_box","type":"rectangle","x":80,"y":750,"width":1200,"height":120,"text":"","fontFamily":3,"fontSize":12,"textAlign":"center","verticalAlign":"middle","strokeColor":"#5c5c5c","backgroundColor":"#fff5f5","strokeWidth":1,"roughness":0,"opacity":100,"fillStyle":"hachure","strokeStyle":"dashed"},
    {"id":"esc_label","type":"text","x":100,"y":760,"width":340,"height":24,"text":"Escalation path (only when truly stuck)","fontFamily":3,"fontSize":14,"textAlign":"left","verticalAlign":"middle","strokeColor":"#c92a2a","backgroundColor":"transparent","strokeWidth":1,"roughness":0,"opacity":100},
    {"id":"esc_text","type":"text","x":100,"y":790,"width":1180,"height":70,"text":"Reviewer can't decide → set state.escalation → bot sends A/B buttons → user replies → orchestrator injects answer → resume.\nIf user doesn't answer in 30 min → orchestrator auto-resolves with full context.\nMid-task: user can send any text in Telegram → routed as a 'note' for the running task (not a new task).","fontFamily":3,"fontSize":12,"textAlign":"left","verticalAlign":"top","strokeColor":"#5c5c5c","backgroundColor":"transparent","strokeWidth":1,"roughness":0,"opacity":100},

    {"id":"a12","type":"arrow","x":300,"y":160,"width":80,"height":0,"startBinding":{"elementId":"s1","focus":0,"gap":1},"endBinding":{"elementId":"s2","focus":0,"gap":1},"strokeColor":"#1971c2","backgroundColor":"transparent","strokeWidth":2,"roughness":0,"opacity":100,"points":[[0,0],[80,0]]},
